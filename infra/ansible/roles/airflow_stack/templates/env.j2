# Managed by Ansible (roles/airflow_stack). Do not edit on the host.
# Passwords are inserted raw — keep DB passwords URL-safe (the rotation guide
# uses `openssl rand -hex`, which is), matching the compose file's URI assembly.
CLOUDSQL_CONNECTION_NAME={{ cloudsql_connection_name }}

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://{{ vault_postgres_user }}:{{ vault_postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ airflow_db }}
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_ASYNC=postgresql+asyncpg://{{ vault_postgres_user }}:{{ vault_postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ airflow_db }}

AIRFLOW_JWT_SECRET={{ vault_airflow_jwt_secret }}

POSTGRES_HOST={{ postgres_host }}
POSTGRES_PORT={{ postgres_port }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ vault_postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
MODEL_STORAGE_BUCKET_NAME={{ model_storage_bucket_name }}

MLFLOW_DB_USER={{ vault_mlflow_db_user }}
MLFLOW_DB_PASSWORD={{ vault_mlflow_db_password }}
MLFLOW_DB={{ mlflow_db }}

AIRFLOW_UID={{ airflow_uid }}
AIRFLOW_ADMIN_USER={{ vault_airflow_admin_user }}
AIRFLOW_ADMIN_PASSWORD={{ vault_airflow_admin_password }}

REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}

FEAST_REGISTRY_PATH=postgresql+psycopg://{{ vault_postgres_user }}:{{ vault_postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/feast-registry
