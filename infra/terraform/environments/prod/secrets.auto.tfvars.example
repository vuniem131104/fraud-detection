# Copy to `secrets.auto.tfvars` (git-ignored) and fill in. Terraform auto-loads
# any *.auto.tfvars. Keeps DB passwords out of the committed tfvars.
#
# The live SQL user is "vuniem". Use its CURRENT password so importing the user
# produces no diff.
sql_users = {
  vuniem = {
    password = "REPLACE_WITH_CURRENT_DB_PASSWORD"
  }
}
