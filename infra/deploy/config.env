# ─────────────────────────────────────────────────────────────────────────────
# Single source of truth for deploy.sh. Every value here was read from the LIVE
# project/cluster (gcloud + helm list) on 2026-07-14, so a from-scratch run
# reproduces the current system exactly. Override any of these via the environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── GCP / cluster ────────────────────────────────────────────────────────────
export PROJECT_ID="${PROJECT_ID:-project-57f7ef9a-6059-4068-ae7}"
export REGION="${REGION:-us-central1}"
export ZONE="${ZONE:-us-central1-a}"          # cluster is ZONAL
export CLUSTER_NAME="${CLUSTER_NAME:-fraud-detection}"

# ── Repo paths (relative to repo root) ───────────────────────────────────────
export HELM_DIR="${HELM_DIR:-infra/k8s/helm}"
export MANIFESTS_DIR="${MANIFESTS_DIR:-infra/k8s/manifests}"
# Aiven Kafka TLS certs used to build the `kafka-certs` secret (git-ignored dir).
export CERTS_DIR="${CERTS_DIR:-certs}"

# ── Node pools (target layout) ───────────────────────────────────────────────
# Spec per pool: "<name>=<machine-type>:<node-count>". The deploy's `nodes` phase
# ENSURES this exact shape (creates missing pools, converges node counts), so a
# from-scratch run lands on it directly — no separate reconfigure step.
# Target: 2× 4-vCPU + 1× 2-vCPU = 10 vCPU / 24 GB (frees 2 vCPU quota for the VM).
export NODE_POOLS_SPEC=(
  "default-pool=e2-custom-4-8192:2"
  "small-pool=e2-custom-2-8192:1"
)
export NODE_DISK_SIZE="${NODE_DISK_SIZE:-75}"
# Guard: allow the phase to shrink an existing pool (drains nodes). 1=yes.
export NODES_ALLOW_SHRINK="${NODES_ALLOW_SHRINK:-1}"

# ── Namespaces ───────────────────────────────────────────────────────────────
export NS_CORE="core"
export NS_SERVING="serving"
export NS_MONITORING="monitoring"
export NS_ESO="external-secrets"
export NS_KEDA="keda"
export NS_INGRESS="ingress-nginx"
export NS_KSERVE="kserve"

# ── Cluster-dependency versions (pinned to the live install) ─────────────────
export KNATIVE_VERSION="${KNATIVE_VERSION:-v1.22.1}"       # Knative Serving + net-istio
export CERT_MANAGER_VERSION="${CERT_MANAGER_VERSION:-v1.20.2}"
export KSERVE_VERSION="${KSERVE_VERSION:-v0.18.0}"          # kserve-crd + kserve-resources (OCI)
export KEDA_VERSION="${KEDA_VERSION:-2.20.1}"
export INGRESS_NGINX_VERSION="${INGRESS_NGINX_VERSION:-4.15.1}"  # controller v1.15.1
export ESO_CHART_VERSION="${ESO_CHART_VERSION:-2.7.0}"     # external-secrets chart == app v2.7.0 (live)

# ── Istio right-sizing ───────────────────────────────────────────────────────
# The net-istio default install is heavy (istiod ~500m/2Gi, gateway HPA can fan
# out to several replicas). These pin it to 1 lean gateway + small istiod, matching
# what the live cluster was hand-tuned to.
export ISTIO_GATEWAY_REPLICAS="${ISTIO_GATEWAY_REPLICAS:-1}"
export ISTIO_GATEWAY_REQ="${ISTIO_GATEWAY_REQ:-cpu=100m,memory=128Mi}"
export ISTIO_GATEWAY_LIM="${ISTIO_GATEWAY_LIM:-cpu=500m,memory=512Mi}"
export ISTIOD_REQ="${ISTIOD_REQ:-cpu=100m,memory=256Mi}"
export ISTIOD_LIM="${ISTIOD_LIM:-cpu=500m,memory=512Mi}"
export ISTIOD_MIN_REPLICAS="${ISTIOD_MIN_REPLICAS:-1}"
export ISTIOD_MAX_REPLICAS="${ISTIOD_MAX_REPLICAS:-2}"

# ── Helm repo URLs ───────────────────────────────────────────────────────────
export KEDA_REPO="https://kedacore.github.io/charts"
export INGRESS_NGINX_REPO="https://kubernetes.github.io/ingress-nginx"
export ESO_REPO="https://charts.external-secrets.io"

# ── Workload Identity bindings: "<GSA_shortname>=<k8s-namespace>/<ksa-name>" ──
# Re-asserted idempotently so app pods can impersonate their GCP SA (no key files).
export WORKLOAD_IDENTITY_BINDINGS=(
  "fraud-detection-sa=core/fraud-detection-sa"
  "prediction-writer-sa=core/prediction-writer-sa"
  "drift-detection-api-sa=core/drift-detection-api-sa"
  "kserve-sa=serving/kserve-sa"
  "eso-secrets-reader=external-secrets/external-secrets"
  "grafana-sa=monitoring/grafana-sa"
  "loki-sa=monitoring/loki-sa"
)

# ── GCP APIs the platform depends on (enabling an already-on API is a no-op) ──
export REQUIRED_APIS=(
  compute.googleapis.com
  container.googleapis.com
  artifactregistry.googleapis.com
  sqladmin.googleapis.com
  redis.googleapis.com
  memorystore.googleapis.com
  servicenetworking.googleapis.com
  secretmanager.googleapis.com
  storage.googleapis.com
  iam.googleapis.com
  iamcredentials.googleapis.com
  cloudresourcemanager.googleapis.com
  logging.googleapis.com
  monitoring.googleapis.com
)
