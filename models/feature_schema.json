{
  "version": 3,
  "offline_source": "warehouse::application.feat_training",
  "online_source": "feast::fraud_detection_service",
  "label_table": "application.labels",
  "target": "label",
  "feature_columns": [
    "amount_usd",
    "channel",
    "auth_3ds_flag",
    "card_brand",
    "card_type",
    "is_virtual",
    "customer_segment",
    "kyc_level",
    "email_verified",
    "merchant_category",
    "merchant_risk_level",
    "card_tx_count_90d",
    "card_amount_sum_90d",
    "card_amount_avg_90d",
    "card_amount_max_90d",
    "card_amount_std_90d",
    "card_distinct_merchant_90d",
    "card_tx_count_7d",
    "user_tx_count_30d",
    "user_amount_avg_30d",
    "user_device_count_30d",
    "user_distinct_country_30d",
    "merchant_tx_count_30d",
    "merchant_amount_avg_30d",
    "merchant_amount_std_30d",
    "merchant_distinct_cards_30d",
    "device_tx_count_30d",
    "device_distinct_users_30d",
    "device_distinct_cards_30d",
    "merch_tx_count_10min",
    "merch_distinct_cards_10min",
    "merch_amount_avg_10min",
    "device_tx_count_1h",
    "device_distinct_users_1h",
    "device_distinct_cards_1h",
    "card_tx_count_5min",
    "card_amount_sum_5min",
    "card_amount_avg_5min",
    "log_amount",
    "hour",
    "weekday",
    "is_night",
    "geo_mismatch",
    "foreign_ip",
    "recipient_differs",
    "account_age_days",
    "card_age_days",
    "device_age_hours",
    "amount_vs_card_avg",
    "amount_vs_card_max",
    "amount_z_vs_card",
    "amount_vs_user_avg",
    "amount_z_vs_merchant",
    "card_acceleration",
    "hours_since_last_card_tx",
    "hours_since_last_user_tx",
    "merchant_spread",
    "merchant_burst",
    "device_burst",
    "device_cards_per_user"
  ],
  "categorical_features": [
    "channel",
    "card_brand",
    "card_type",
    "customer_segment",
    "merchant_category",
    "is_virtual",
    "email_verified",
    "auth_3ds_flag"
  ],
  "categorical_encoders": {
    "channel": {
      "mobile_app": 0,
      "pos": 1,
      "web": 2
    },
    "card_brand": {
      "Amex": 0,
      "Mastercard": 1,
      "Visa": 2
    },
    "card_type": {
      "credit": 0,
      "debit": 1
    },
    "customer_segment": {
      "normal": 0,
      "premium": 1,
      "vip": 2
    },
    "merchant_category": {
      "crypto": 0,
      "digital_goods": 1,
      "electronics": 2,
      "fashion": 3,
      "gambling": 4,
      "gaming": 5,
      "grocery": 6,
      "money_transfer": 7,
      "pharmacy": 8,
      "restaurant": 9,
      "subscription": 10,
      "travel": 11,
      "utilities": 12
    },
    "is_virtual": {
      "False": 0,
      "True": 1
    },
    "email_verified": {
      "False": 0,
      "True": 1
    },
    "auth_3ds_flag": {
      "False": 0,
      "True": 1,
      "missing": 2
    }
  },
  "on_demand_features": [
    "log_amount",
    "hour",
    "weekday",
    "is_night",
    "geo_mismatch",
    "foreign_ip",
    "recipient_differs",
    "account_age_days",
    "card_age_days",
    "device_age_hours",
    "amount_vs_card_avg",
    "amount_vs_card_max",
    "amount_z_vs_card",
    "amount_vs_user_avg",
    "amount_z_vs_merchant",
    "card_acceleration",
    "hours_since_last_card_tx",
    "hours_since_last_user_tx",
    "merchant_spread",
    "merchant_burst",
    "device_burst",
    "device_cards_per_user"
  ],
  "serving_sources": {
    "batch_redis": [
      "card_features",
      "user_features",
      "merchant_features",
      "device_features"
    ],
    "flink_push": [
      "merchant_realtime",
      "device_realtime"
    ],
    "sync_sorted_set": [
      "card_tx_count_5min",
      "card_amount_sum_5min",
      "card_amount_avg_5min"
    ]
  },
  "windows": {
    "card_velocity_s": 300,
    "merchant_rt_s": 600,
    "device_rt_s": 3600
  },
  "lgb_params": {
    "objective": "binary",
    "metric": [
      "average_precision",
      "auc"
    ],
    "boosting_type": "gbdt",
    "learning_rate": 0.02,
    "num_leaves": 128,
    "min_child_samples": 100,
    "feature_fraction": 0.7,
    "bagging_fraction": 0.85,
    "bagging_freq": 1,
    "lambda_l1": 0.1,
    "lambda_l2": 0.1,
    "verbose": -1,
    "n_jobs": -1,
    "seed": 42
  }
}